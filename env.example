# 复制成 .env 后本地调试用（Vercel 上直接配环境变量即可）
#
# 面板访问密码
PW=change-me

# DNSHE API 凭证
Key=cfsd_xxxxxxxxxxxxxxxx
Secret=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 操作主域名（DNSHE 账号下已注册）
YM=y1s1.cc.cd

# 外部执行接口（GitHub Actions）密钥，可选但强烈建议
CRON_SECRET=random-long-string

# 可选：自定义优选地址来源
# SOURCE_IPV6=https://bestcf.pages.dev/cfyes/ipv6.txt
# SOURCE_IPV4=https://bestcf.pages.dev/wetest/ipv4.txt
